# ============================================================
# Sentinel-X — réglages de la partie cybersécurité
# Copier en security/.env puis adapter :  cp security/.env.example security/.env
# Le vrai .env est ignoré par Git. Lu par tous les scripts de security/.
# ============================================================

# Numéro de groupe : topics MQTT (sentinelx/g<n>/...) et compte du boîtier (esp-g<n>)
GROUP_NUMBER=11

# IP du PC serveur sur le Wi-Fi de table (choisie avec l'infra). Inscrite dans les
# certificats : si elle change, relancer make-pki.sh et re-flasher le boîtier.
SERVER_IP=10.10.11.1

# Adresse où tester le broker (test-broker.sh, self-audit.sh) :
#   localhost  -> broker lancé sur ce PC (run-test-broker.sh, ou stack de l'infra en local)
#   10.10.11.1 -> broker sur le Wi-Fi de table
BROKER_HOST=localhost

# Pare-feu (hardening/ufw-rules.sh) : carte Wi-Fi du point d'accès (voir : ip a)
WIFI_IF=wlan0
# KEEP_SSH=no pour fermer complètement SSH
KEEP_SSH=yes
