# Copier ce fichier en .env puis adapter les valeurs. Le .env n'est jamais commité.
# Ces variables servent à la pile autonome (backend/docker-compose.yml).
# Variables lues par le backend lui-même : voir README.md.

# --- Ports exposés sur le PC ---
API_PORT=3000
MQTT_PORT=1883

# --- Base de données PostgreSQL ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=changer-ce-mot-de-passe
POSTGRES_DB=sentinel

# --- Broker MQTT ---
# Dans Docker le backend joint le broker par son nom de service.
MQTT_URL=mqtt://mosquitto:1883
# Laisser vide tant que le broker accepte les connexions anonymes.
MQTT_USERNAME=
MQTT_PASSWORD=

# Racine des topics et format des commandes.
#   Contrat par défaut  : sentinel      + state   ({ "buzzer": bool, "led": "red" })
#   Firmware du groupe  : sentinelx/g3  + command ({ "command": "BUZZER_ON" })
MQTT_BASE_TOPIC=sentinel
MQTT_CMD_FORMAT=state

# --- Backend ---
# Origine autorisée pour le dashboard (CORS). * = toutes, à restreindre hors démo.
CORS_ORIGIN=*
# Sans message du boîtier pendant ce délai (secondes), il est considéré hors ligne.
DEVICE_OFFLINE_AFTER_S=15
