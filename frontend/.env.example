# Copier ce fichier en .env puis adapter les valeurs.

# true = données simulées (aucun backend requis), false = appels API réels
VITE_USE_MOCK=true

# Adresse du backend sur le PC Serveur Local
VITE_API_URL=http://localhost:3000

# Optionnel : par défaut déduit de VITE_API_URL (ws://.../ws)
# VITE_WS_URL=ws://localhost:3000/ws

# Optionnel : par défaut VITE_API_URL/api/v1/camera/stream
# VITE_CAMERA_URL=http://localhost:3000/api/v1/camera/stream
