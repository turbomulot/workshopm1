# Copier ce fichier en .env puis adapter les valeurs.

# true = données simulées (aucun backend requis), false = appels API réels
VITE_USE_MOCK=true

# Adresse du backend sur le PC Serveur Local
VITE_API_URL=http://localhost:3000

# Optionnel : par défaut déduit de VITE_API_URL (ws://.../ws)
# VITE_WS_URL=ws://localhost:3000/ws

# Optionnel : par défaut VITE_API_URL/api/v1/camera/stream
# VITE_CAMERA_URL=http://localhost:3000/api/v1/camera/stream

# Service employés/badges indépendant du backend capteurs et de VITE_USE_MOCK.
# Le proxy /access-api est disponible avec npm run dev.
# En déploiement, configurer ce chemin dans le reverse proxy ou fournir l'URL Flask.
VITE_ACCESS_API_URL=/access-api
# Pour afficher aussi la webcam sur Supervision, même avec les capteurs simulés :
# VITE_CAMERA_URL=/access-api/video
