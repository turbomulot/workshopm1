# Copier ce fichier en .env puis adapter les valeurs.
# Sans fichier .env : caméra et IA réelles sur 127.0.0.1:5001, capteurs indisponibles.

# true = tout est simulé (aucun service requis), false = données réelles
VITE_USE_MOCK=false

# Service IA (webcam-detection/stream_detection.py) : caméra, détection, journal
VITE_AI_URL=http://127.0.0.1:5001

# Backend capteurs / actionneurs sur le PC Serveur Local.
# Laisser commenté tant qu'il n'existe pas : les capteurs s'affichent « No data ».
# VITE_API_URL=http://localhost:3000

# Optionnel : par défaut déduit de VITE_API_URL (ws://.../ws)
# VITE_WS_URL=ws://localhost:3000/ws

# Optionnel : par défaut VITE_AI_URL/video
# VITE_CAMERA_URL=http://127.0.0.1:5001/video
