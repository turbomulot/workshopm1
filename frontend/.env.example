# Copier ce fichier en .env puis adapter les valeurs. Le .env n'est jamais commité.
# Sans fichier .env : caméra et IA réelles sur 127.0.0.1:5001, capteurs indisponibles.

# true = tout est simulé (aucun service requis), false = données réelles
VITE_USE_MOCK=false

# Service IA (webcam-detection/stream_detection.py) : caméra, détection, journal
VITE_AI_URL=http://127.0.0.1:5001

# Backend capteurs / actionneurs (backend/). Port = API_PORT de backend/.env.
# Laisser commenté pour travailler sans backend : les capteurs s'affichent « No data ».
VITE_API_URL=http://localhost:3000

# Optionnel : adresse du temps réel (socket.io) si elle diffère de VITE_API_URL.
# VITE_WS_URL=http://localhost:3000

# Optionnel : par défaut VITE_AI_URL/video
# VITE_CAMERA_URL=http://127.0.0.1:5001/video
