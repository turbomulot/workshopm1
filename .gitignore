# ---------- Environnement virtuel Python ----------
venv/
.venv/
env/

# ---------- Fichiers générés par Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ---------- SECRETS (ne jamais versionner : exigé par le sujet) ----------
.env
*.pem
*.key
*.crt
secrets.*

# ---------- Modèles IA lourds (téléchargés automatiquement) ----------
*.pt
*.onnx
runs/

# ---------- Données volumineuses ----------
# Décommente ces lignes si vos datasets sont trop gros pour Git :
# data/raw/
# *.csv

# ---------- Logs ----------
*.log
logs/

# ---------- macOS ----------
.DS_Store
.AppleDouble
._*

# ---------- Éditeurs ----------
.vscode/
.idea/

# ---------- Cybersécurité (security/) ----------
# PKI générée : certificats et clés du groupe, jamais versionnés
security/pki/certs/
*.csr
*.srl

# Mots de passe générés par security/mosquitto/make-accounts.sh
security/secrets/

# Comptes Mosquitto (mots de passe hachés) et ACL générée depuis acl.template
security/mosquitto/passwd
security/mosquitto/passwd.txt
security/mosquitto/acl

# Captures réseau Wireshark / tcpdump (peuvent contenir des données sensibles)
*.pcap
*.pcapng

# Liste réelle des cibles du pentest (IP des autres groupes)
security/audit/cibles.txt

# Exception : le MODÈLE de secrets du firmware est suivi (sans valeurs)
!security/integration/firmware/secrets.example.h
